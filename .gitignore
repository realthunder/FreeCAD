# generate_export_header writes this into the source tree at configure time,
# so its contents are whatever platform configured last -- it was tracked
# once with MSVC's __declspec in it, which no gcc build can compile
/src/3rdParty/customtitlebarkit/include/customtitlebarkit/export.h

# npm dependencies of the viewer's DOM UI layer: the WASM viewer build
# runs `npm install` in the source tree (src/Gui/Renderer/wasm/CMakeLists.txt),
# so this appears for anyone who builds it
/src/Gui/Renderer/web/node_modules/

# The golden render reference images (tests/render/CMakeLists.txt) are
# their own repository, checked out here. Ignored only until it has a
# remote and a .gitmodules entry; a submodule path may stay listed here
# harmlessly.
