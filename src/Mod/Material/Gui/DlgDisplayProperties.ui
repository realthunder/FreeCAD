        </property>
        <property name="text">
         <string>Map face colors</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="checkBoxMapLineColor">
        <property name="toolTip">
         <string>Mapping edge color from base shape if possible.
