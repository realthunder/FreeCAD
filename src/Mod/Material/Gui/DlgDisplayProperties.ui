     </property>
     <layout class="QGridLayout" name="gridLayout_5">
      <item row="0" column="0">
       <widget class="QCheckBox" name="checkBoxMapFaceColor">
        <property name="toolTip">
         <string>Mapping face color from derived shape if possible.
