uniform color for all edges.</string>
        </property>
        <property name="text">
         <string>Map edge colors</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="checkBoxMapTransparency">
        <property name="toolTip">
         <string>Mapping face transparency from derived shape if possible.
