          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Disable recompute while dragging</string>
        </property>
        <property name="toolTip">
         <string>Prevents the model from recalculating while manipulating draggers. The shape updates only after release of the mouse button.</string>
