        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>EnableGizmos</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Gui/Gizmos</cstring>
        </property>
